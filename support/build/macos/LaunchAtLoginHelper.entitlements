<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- shareMe: copy of LaunchAtLogin-Legacy 5.0.2 Sources/LaunchAtLogin/LaunchAtLogin.entitlements, used to
     re-sign Contents/Library/LoginItems/LaunchAtLoginHelper.app ad-hoc (its own build step cannot sign
     because the build runs with code signing off). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
